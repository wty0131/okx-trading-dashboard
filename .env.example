# OKX 系统环境变量模板 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，切勿提交）
# 本面板从不读取密钥文件；okx 客户端只从环境变量取凭据，账户类接口默认 dry_run。

# ---- 账户凭据（可选；缺失时账户类功能保持 dry_run 安全模式） ----
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ---- 行情代理（可选；仅公开行情类请求使用，账户类私有接口勿走公网代理） ----
# OKX_PROXY=http://127.0.0.1:7897
# OKX_HTTP_PROXY=http://127.0.0.1:7897
# OKX_HTTPS_PROXY=http://127.0.0.1:7897

# ---- 离线调试（可选；1 = 行情完全离线，仅使用本地缓存，用于自检） ----
# OKX_MARKET_OFFLINE=0
